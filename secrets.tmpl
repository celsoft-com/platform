# Secrets this repo needs to deploy its demo app.
# Values go in .env.secrets (gitignored). Run `mise run secrets:ensure` to create it.

# Cloudflare API token
#   Create: https://dash.cloudflare.com/profile/api-tokens > Create Token > Custom token
#   Permissions:
#     Account > Workers Scripts > Edit      deploy and delete Workers, set their secrets
#     Account > Hyperdrive > Edit           create and delete database connection configs
#     Account > Account Settings > Read     find the account id
#     Zone > Workers Routes > Edit          attach app and preview hostnames
#     Zone > Zone > Read                    find the zone by its domain
#   Account Resources: Include > your account
#   Zone Resources: Include > Specific zone > your apex domain
CLOUDFLARE_API_TOKEN=

# Neon API key
#   Create: https://console.neon.tech/app/settings/api-keys
#   Type: a personal key, or an organization key if the app lives in a Neon organization;
#   a project-scoped key cannot create the app's Neon project.
NEON_API_KEY=
