# Secrets this repo needs to deploy its demo app.
# Values go in .env.secrets (gitignored). Run `mise run secrets:ensure` to create it.

# Cloudflare API token: https://dash.cloudflare.com/profile/api-tokens
# Permissions: Account > Workers Scripts: Edit, Account > Hyperdrive: Edit,
#   Zone > Workers Routes: Edit, Zone > DNS: Edit, Zone > Zone: Read
CLOUDFLARE_API_TOKEN=

# Neon API key: https://console.neon.tech/app/settings/api-keys
NEON_API_KEY=
