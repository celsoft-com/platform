{
  "$schema": "./node_modules/@celsoft/platform/schema.json",
  "name": "demo",
  "hostname": "${DEMO_HOSTNAME}",
  "worker": "src/worker.ts",
  "frontend": "dist",
  "compatibilityDate": "2026-10-01",
  "database": true,
  "email": true,
  "auth": { "organizations": true, "apiTokens": true, "signup": "invite" },
  "files": true,
  "live": true,
  "mcp": true,
  "access": true,
  "previews": { "sendEmailTo": ["*@celsoft.com"] }
}
