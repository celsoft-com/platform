#!/usr/bin/env bash
#MISE description="Scaffold an app from the template, install the locally packed platform, type-check it, and generate its migrations"
#MISE depends=["build"]
set -euo pipefail
cd "$MISE_PROJECT_ROOT"

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

(cd packages/platform && pnpm pack --pack-destination "$work" >/dev/null)
tarball=$(ls "$work"/*.tgz)

(cd "$work" && node "$MISE_PROJECT_ROOT/packages/create-platform-app/dist/cli.js" app --hostname app.example.com --neon-project quiet-meadow-12345678 </dev/null)

cd "$work/app"
npm install --no-audit --no-fund --loglevel=error "$tarball"
npm install --no-audit --no-fund --loglevel=error
npx --no-install tsc -p .
npx --no-install @celsoft/platform --help >/dev/null
npx --no-install @celsoft/platform db generate >/dev/null
ls drizzle/*.sql >/dev/null
echo "✓ template app installs, type-checks, runs the platform CLI, and generates its migrations"
