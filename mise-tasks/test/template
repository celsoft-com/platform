#!/usr/bin/env bash
#MISE description="Start an app the documented way from the locally packed platform: install, skills, new; then type-check it, generate its migrations and run its tests"
#MISE depends=["build"]
set -euo pipefail
cd "$MISE_PROJECT_ROOT"

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

(cd packages/platform && pnpm pack --pack-destination "$work" >/dev/null)
tarball=$(ls "$work"/*.tgz)

mkdir "$work/app"
cd "$work/app"
npm install --no-audit --no-fund --loglevel=error "$tarball"
npx --no-install @celsoft/platform skills
test -f .claude/skills/celsoft-platform-setup/SKILL.md
before=$(find . -path ./node_modules -prune -o -type f -print | sort | xargs shasum)
npx --no-install @celsoft/platform new --dry-run --name app --hostname app.example.com </dev/null >"$work/dry-run.txt"
grep -q "would write platform.jsonc" "$work/dry-run.txt"
test "$before" = "$(find . -path ./node_modules -prune -o -type f -print | sort | xargs shasum)"
! npx --no-install @celsoft/platform skills --dry-run 2>/dev/null
npx --no-install @celsoft/platform new --name app --hostname app.example.com </dev/null
npx --no-install tsc -p .
npx --no-install @celsoft/platform --help >/dev/null
npx --no-install @celsoft/platform db generate >/dev/null
ls drizzle/*.sql >/dev/null
test -f mise.toml
npm test
test -f node_modules/@celsoft/platform/skills/celsoft-platform/SKILL.md
grep -q "node_modules/@celsoft/platform/skills/" AGENTS.md
grep -q "^.claude/skills/celsoft-platform\*/$" .gitignore
echo "✓ an app started from the package gets its skills, previews new without writing, gets its files from new, type-checks, generates its migrations, and passes its tests"
