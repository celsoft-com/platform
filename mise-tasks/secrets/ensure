#!/usr/bin/env bash
#MISE description="Create .env.secrets with a blank entry for every name in secrets.tmpl, then report which are still empty"
set -euo pipefail
source "$(dirname "${BASH_SOURCE[0]}")/../_lib.sh"
cd "$MISE_PROJECT_ROOT"

manifest=secrets.tmpl
target=.env.secrets

if ! git check-ignore -q "$target"; then
  error "$target is not gitignored; add it to .gitignore first"
  exit 1
fi

if [[ ! -f $target ]]; then
  (umask 077; : > "$target")
  success "created $target"
fi

empty=0
for name in $(grep -E '^[A-Za-z_][A-Za-z0-9_]*=' "$manifest" | cut -d= -f1); do
  if ! grep -qE "^${name}=" "$target"; then
    printf '%s=\n' "$name" >> "$target"
    info "$name: added blank entry"
  fi
  if grep -qE "^${name}=.+" "$target"; then
    success "$name"
  else
    warn "$name: empty"
    empty=1
  fi
done

if (( empty )); then
  info "fill the empty entries in $target; $manifest says where each value comes from"
  exit 1
fi
