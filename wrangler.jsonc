// The Platform Instance, deployed from the repo root by Deploy to Cloudflare and Workers Builds.
// docs/design.md section 16 is the design.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "platform",
  "main": "apps/instance/src/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "durable_objects": { "bindings": [{ "name": "STATE", "class_name": "InstanceState" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["InstanceState"] }],
  "observability": { "enabled": true }
}
