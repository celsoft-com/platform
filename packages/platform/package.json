{
  "name": "@celsoft/platform",
  "version": "0.2.0",
  "description": "Deploy apps to Cloudflare Workers with Neon Postgres, prod on push and a preview per pull request",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/celsoft-com/platform.git", "directory": "packages/platform" },
  "homepage": "https://github.com/celsoft-com/platform#readme",
  "publishConfig": { "access": "public" },
  "type": "module",
  "bin": {
    "platform": "./dist/cli.js"
  },
