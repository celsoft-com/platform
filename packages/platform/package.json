    "pg": "^8.23.1",
    "postgres": "^3.4.9",
    "wrangler": "^4.152.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "typescript": "7.0.2"
