{
  "name": "@celsoft/platform",
  "version": "0.33.0",
  "description": "Deploy apps to Cloudflare Workers with Neon Postgres, prod on push and a preview per pull request",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/celsoft-com/platform.git",
    "directory": "packages/platform"
  },
  "homepage": "https://github.com/celsoft-com/platform#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "platform": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/runtime/index.js",
    "./schema": "./dist/schema.js",
    "./live": "./dist/runtime/live-client.js",
    "./client": "./dist/runtime/client.js",
    "./vite": "./dist/vite.js",
    "./testing": "./dist/testing.js"
  },
  "files": [
    "dist",
    "schema.json",
    "skills",
    "template"
  ],
  "scripts": {
    "prepare": "tsc -b && node dist/write-schema.js"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.12",
    "@better-auth/core": "1.7.12",
    "@better-auth/mcp": "1.7.12",
    "@better-auth/oauth-provider": "1.7.12",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@neondatabase/api-client": "^2.7.3",
    "@orpc/client": "1.16.1",
    "@orpc/contract": "1.16.1",
    "@orpc/openapi": "1.16.1",
    "@orpc/openapi-client": "1.16.1",
    "@orpc/server": "1.16.1",
    "@orpc/zod": "1.16.1",
    "better-auth": "^1.7.12",
    "cloudflare": "^7.3.0",
    "drizzle-kit": "^0",
    "esbuild": "^0.28.2",
    "jsonc-parser": "^3.3.1",
    "pg": "^8.23.1",
    "wrangler": "^4.152.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@types/pg": "^8.23.1",
    "drizzle-orm": "^0.45.4",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "drizzle-orm": "^0"
  }
}
