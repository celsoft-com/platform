{
  "$schema": "./node_modules/@celsoft/platform/schema.json",
  "name": "{{name}}",
  "hostname": "{{hostname}}",
  "worker": "src/worker.ts",
  "frontend": { "dir": "public" },
  "compatibilityDate": "{{compatibilityDate}}",
  "database": true
  // Accounts and sign-in: uncomment both lines. Sign-up is invite-only once the app has its first
  // account, which becomes the owner and invites people at /invites; "open" lets anyone sign up.
  // "email": true,
  // "auth": { "signup": "invite" }
}
